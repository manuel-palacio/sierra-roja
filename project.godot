; Engine configuration file.
config_version=5

[application]

config/name="Sierra Roja"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

NoiseBus="*res://src/core/noise_bus.gd"
SaveGame="*res://src/save/save_game.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
renderer/rendering_method.mobile="gl_compatibility"

[navigation]

world/map_use_async_iterations=false
world/region_use_async_iterations=false

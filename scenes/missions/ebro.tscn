[node name="Ebro" type="Node3D"]
script = ExtResource("1_mission")
bounds_rect = Rect2(-55, -45, 110, 90)
night = true
title = "The crossing"
briefing_lines = PackedStringArray("Silence the three sentries on the bank before the boats set out. The clock is at the top of the screen.", "Not a shot, not a shout: an alarm anywhere before the last of them is down and the boats come in under fire.", "Then both of you to the landing. Lose either one and the mission fails.")

